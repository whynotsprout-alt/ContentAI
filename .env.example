# Copy to .env, replace every placeholder, and keep the file outside release archives.

# Runtime and Docker
CONTENTAI_ENV=production
WEB_PORT=5180
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# PostgreSQL (required by Docker Compose)
POSTGRES_DB=contentai
POSTGRES_USER=contentai
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
CONTENTAI_DATABASE__URL=postgresql+psycopg://contentai:replace-with-a-long-url-safe-password@postgres:5432/contentai
# Capacity declarations are checked at startup. Keep the calculated total strictly below
# 70% of (MAX_CONNECTIONS - RESERVED_CONNECTIONS); the default single-host budget is 64.
CONTENTAI_DATABASE__MAX_CONNECTIONS=100
CONTENTAI_DATABASE__RESERVED_CONNECTIONS=5
CONTENTAI_DATABASE__API_REPLICAS=1
CONTENTAI_DATABASE__DISPATCHER_REPLICAS=1
CONTENTAI_DATABASE__AGENT_WORKER_REPLICAS=1
CONTENTAI_DATABASE__AGENT_WORKER_CONCURRENCY=4
CONTENTAI_DATABASE__BACKGROUND_WORKER_REPLICAS=1
CONTENTAI_DATABASE__BACKGROUND_WORKER_CONCURRENCY=2
CONTENTAI_DATABASE__SIDE_EFFECT_WORKER_REPLICAS=1
CONTENTAI_DATABASE__SIDE_EFFECT_WORKER_CONCURRENCY=1
CONTENTAI_DATABASE__CHECKPOINT_POOL_SIZE=2
CONTENTAI_DATABASE__BEAT_REPLICAS=1
CONTENTAI_DATABASE__MIGRATION_REPLICAS=1
CONTENTAI_DATABASE__OPS_REPLICAS=1
CONTENTAI_AGENT__WORKER_CONCURRENCY=4
CONTENTAI_AGENT__CELERY_QUEUE=agent-executions
CONTENTAI_AGENT__CELERY_BACKGROUND_QUEUE=agent-background
CONTENTAI_AGENT__CELERY_SIDE_EFFECT_QUEUE=agent-side-effects

# Application connectivity
CONTENTAI_REDIS__URL=redis://redis:6379/0
# Production requires the public web origin. Development also allows localhost automatically.
CONTENTAI_SERVER__FRONTEND_ORIGINS=https://content.example.com

# Model relay and optional search providers
CONTENTAI_SEARCH__TRAFFIC_RELAY_API_KEY=replace-with-relay-key
CONTENTAI_SEARCH__TIKHUB_API_KEY=
CONTENTAI_SEARCH__METASO_API_KEY=
CONTENTAI_SEARCH__ANSPIRE_API_KEY=

# Authentication
# This account is created only if the email is absent; restarting never changes its password or role.
CONTENTAI_AUTH__BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CONTENTAI_AUTH__BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
CONTENTAI_AUTH__SESSION_COOKIE_NAME=contentai_session
CONTENTAI_AUTH__CSRF_COOKIE_NAME=contentai_csrf
