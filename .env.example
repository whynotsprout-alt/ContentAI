# Copy to .env and fill real values locally.

CONTENTAI_ENV=development

# Server / CORS
# Development also auto-adds http://localhost:5173 and http://127.0.0.1:5173.
CONTENTAI_SERVER__FRONTEND_ORIGINS=["http://localhost:5173"]

# Database
CONTENTAI_DATABASE__URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/contentai
CONTENTAI_DATABASE__POOL_SIZE=20
CONTENTAI_DATABASE__MAX_OVERFLOW=40
CONTENTAI_DATABASE__POOL_TIMEOUT=30
CONTENTAI_DATABASE__POOL_RECYCLE_SECONDS=600

# LLM
CONTENTAI_LLM__CHAT_MODEL=claude-opus-4-6
CONTENTAI_LLM__PLANNING_MODEL=claude-opus-4-6
CONTENTAI_LLM__SUMMARY_MODEL=claude-opus-4-6
CONTENTAI_LLM__EMBEDDING_MODEL=
CONTENTAI_LLM__TEMPERATURE=0.2
CONTENTAI_LLM__CHAT_MAX_TOKENS=4096
CONTENTAI_LLM__STRUCTURED_MAX_TOKENS=4096

# Agent runtime
CONTENTAI_AGENT__MEMORY_AFTER_TURN_ENABLED=false
CONTENTAI_AGENT__CONTEXT_MAX_MESSAGES=24
CONTENTAI_AGENT__CONTEXT_MIN_FOCUSED_MESSAGES=6
CONTENTAI_AGENT__MAX_ITERATIONS=8
CONTENTAI_AGENT__RECURSION_LIMIT=20
CONTENTAI_AGENT__EVENT_FLUSH_INTERVAL_MS=250
CONTENTAI_AGENT__EVENT_FLUSH_MAX_CHARS=1200
CONTENTAI_AGENT__CHECKPOINT_BACKEND=postgres
CONTENTAI_AGENT__MEMORY_BACKEND=postgres
CONTENTAI_AGENT__TOOL_TIMEOUT_SECONDS=60
CONTENTAI_AGENT__STREAMING_ENABLED=true

# Search / model relay
CONTENTAI_SEARCH__TRAFFIC_RELAY_BASE_URL=https://traffic-relay.onrender.com/v1
CONTENTAI_SEARCH__TRAFFIC_RELAY_API_KEY=
CONTENTAI_SEARCH__TIKHUB_API_KEY=
CONTENTAI_SEARCH__METASO_API_KEY=
CONTENTAI_SEARCH__METASO_SEARCH_API_KEY=
CONTENTAI_SEARCH__METASO_KEY=
CONTENTAI_SEARCH__ANSPIRE_API_KEY=
CONTENTAI_SEARCH__SEARCH_CACHE_TTL_SECONDS=300
CONTENTAI_SEARCH__HOTSPOT_CACHE_TTL_SECONDS=180

# Auth
CONTENTAI_AUTH__ENABLED=false
CONTENTAI_AUTH__OIDC_ISSUER=
CONTENTAI_AUTH__OIDC_AUDIENCE=
CONTENTAI_AUTH__OIDC_JWKS_URL=
CONTENTAI_AUTH__USER_CLAIM=sub
CONTENTAI_AUTH__TENANT_CLAIM=tenant_id
CONTENTAI_AUTH__ACCOUNTS_CLAIM=allowed_account_ids
CONTENTAI_AUTH__TOOLS_CLAIM=tool_permissions
CONTENTAI_AUTH__ALLOW_UNSIGNED_TEST_TOKENS=false
