# Copy to .env and fill real values locally.

CONTENTAI_ALLOW_SYSTEM_PYTHON=0
CONTENTAI_FRONTEND_ORIGINS=http://localhost:5173

# LLM 模型统一配置
CONTENTAI_LLM_MODEL=claude-opus-4-6
CONTENTAI_LLM_MAX_TOKENS=4096
CONTENTAI_LLM_TEMPERATURE=0.2

CONTENTAI_DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/contentai

TRAFFIC_RELAY_BASE_URL=https://traffic-relay.onrender.com/v1
TRAFFIC_RELAY_API_KEY=
TIKHUB_API_KEY=
METASO_API_KEY=
ANSPIRE_API_KEY=

CONTENTAI_API_PORT=8000
