# Copy to .env and fill real values locally.

CONTENTAI_ENV=development

# Server / CORS
# Development also allows localhost and 127.0.0.1 on any port.
CONTENTAI_SERVER__FRONTEND_ORIGINS=http://127.0.0.1:5180
CONTENTAI_SERVER__OUTBOX_READINESS_THRESHOLD=10000
CONTENTAI_SERVER__OUTBOX_MAX_AGE_SECONDS=120

# Database
CONTENTAI_DATABASE__URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/contentai
CONTENTAI_DATABASE__POOL_SIZE=20
CONTENTAI_DATABASE__MAX_OVERFLOW=40
CONTENTAI_DATABASE__POOL_TIMEOUT=30
CONTENTAI_DATABASE__POOL_RECYCLE_SECONDS=600

# Redis / distributed execution
CONTENTAI_REDIS__URL=redis://127.0.0.1:6379/0
CONTENTAI_REDIS__EVENT_TTL_SECONDS=86400
CONTENTAI_REDIS__EVENT_MAX_LENGTH=10000
CONTENTAI_REDIS__EVENT_BLOCK_MS=5000

# Logging. Every Python service writes a rotating UTF-8 file under ./logs.
CONTENTAI_LOGGING__LEVEL=INFO
CONTENTAI_LOGGING__MAX_BYTES=10485760
CONTENTAI_LOGGING__BACKUP_COUNT=7

# LLM
CONTENTAI_LLM__CHAT_MODEL=claude-opus-4-8
# Used by structured tasks: session titles, topic scoring, deep research, and memory extraction.
CONTENTAI_LLM__SUMMARY_MODEL=claude-opus-4-8
CONTENTAI_LLM__TEMPERATURE=0.2
CONTENTAI_LLM__CONTEXT_WINDOW_TOKENS=32000
CONTENTAI_LLM__CHAT_MAX_TOKENS=8000
CONTENTAI_LLM__STRUCTURED_MAX_TOKENS=8000

# Agent runtime
CONTENTAI_AGENT__MEMORY_AFTER_TURN_ENABLED=false
CONTENTAI_AGENT__CONTEXT_MAX_MESSAGES=40
CONTENTAI_AGENT__CONTEXT_MIN_FOCUSED_MESSAGES=6
CONTENTAI_AGENT__MAX_ITERATIONS=8
CONTENTAI_AGENT__RECURSION_LIMIT=20
CONTENTAI_AGENT__EVENT_FLUSH_INTERVAL_MS=250
CONTENTAI_AGENT__EVENT_FLUSH_MAX_CHARS=1200
CONTENTAI_AGENT__RUNTIME_CACHE_CAPACITY=32
CONTENTAI_AGENT__CHECKPOINT_BACKEND=postgres
CONTENTAI_AGENT__MEMORY_BACKEND=postgres
CONTENTAI_AGENT__TOOL_TIMEOUT_SECONDS=60
CONTENTAI_AGENT__CELERY_QUEUE=agent-executions
CONTENTAI_AGENT__CELERY_BACKGROUND_QUEUE=agent-background
CONTENTAI_AGENT__WORKER_CONCURRENCY=4
CONTENTAI_AGENT__WORKER_CLAIM_TIMEOUT_SECONDS=120
CONTENTAI_AGENT__WORKER_LEASE_SECONDS=120
CONTENTAI_AGENT__WORKER_HEARTBEAT_SECONDS=15
CONTENTAI_AGENT__MAX_EXECUTION_ATTEMPTS=3
CONTENTAI_AGENT__POSTPROCESS_MAX_ATTEMPTS=3
CONTENTAI_AGENT__POSTPROCESS_RETRY_BASE_SECONDS=5
CONTENTAI_AGENT__USER_DAILY_RUN_LIMIT=500
CONTENTAI_AGENT__CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
CONTENTAI_AGENT__WORKER_SOFT_TIME_LIMIT_SECONDS=1800
CONTENTAI_AGENT__WORKER_TIME_LIMIT_SECONDS=1860

# Search / model relay
CONTENTAI_SEARCH__TRAFFIC_RELAY_BASE_URL=https://traffic-relay.onrender.com/v1
CONTENTAI_SEARCH__TRAFFIC_RELAY_API_KEY=
CONTENTAI_SEARCH__TIKHUB_API_KEY=
CONTENTAI_SEARCH__METASO_API_KEY=
CONTENTAI_SEARCH__ANSPIRE_API_KEY=
CONTENTAI_SEARCH__SEARCH_CACHE_TTL_SECONDS=300
CONTENTAI_SEARCH__HOTSPOT_CACHE_TTL_SECONDS=180
CONTENTAI_SEARCH__HOTSPOT_PER_SOURCE_LIMIT=10
CONTENTAI_SEARCH__HOTSPOT_RAW_CANDIDATE_LIMIT=200
CONTENTAI_SEARCH__HOTSPOT_AGGREGATED_CANDIDATE_LIMIT=60

# Built-in email/password authentication
CONTENTAI_AUTH__PUBLIC_BASE_URL=http://127.0.0.1:5180
CONTENTAI_AUTH__BOOTSTRAP_ADMIN_EMAILS=["admin@example.com"]
CONTENTAI_AUTH__SESSION_COOKIE_NAME=contentai_session
CONTENTAI_AUTH__CSRF_COOKIE_NAME=contentai_csrf
CONTENTAI_AUTH__SESSION_DAYS=30
CONTENTAI_AUTH__REQUIRE_EMAIL_VERIFICATION=true
CONTENTAI_AUTH__VERIFICATION_HOURS=24
CONTENTAI_AUTH__RESET_MINUTES=30
CONTENTAI_AUTH__LOGIN_MAX_FAILURES=5
CONTENTAI_AUTH__LOGIN_LOCK_MINUTES=15
CONTENTAI_AUTH__RESEND_VERIFICATION_LIMIT=3
CONTENTAI_AUTH__RESEND_VERIFICATION_WINDOW_SECONDS=3600

# Email. console stores mail in the development outbox; production requires smtp.
CONTENTAI_AUTH__MAIL_BACKEND=console
CONTENTAI_AUTH__SMTP_HOST=
CONTENTAI_AUTH__SMTP_PORT=587
CONTENTAI_AUTH__SMTP_USERNAME=
CONTENTAI_AUTH__SMTP_PASSWORD=
CONTENTAI_AUTH__SMTP_FROM_EMAIL=
CONTENTAI_AUTH__SMTP_USE_TLS=true
